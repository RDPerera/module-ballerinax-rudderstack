    "/v1/batch": {
      "post": {
        "tags": [
          "Event Stream"
        ],
        "summary": "Send several events in one request",
        "description": "Max 4 MB per request and 32 KB per event. Each event sets `type`.",
        "operationId": "batch",
        "parameters": [
          {
            "$ref": "#/components/parameters/AnonymousIdHeader"
          },
          {
            "$ref": "#/components/parameters/SentAtHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Accepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/SourceDisabled"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/activation": {
      "post": {
        "tags": [
          "Activation"
        ],
        "summary": "Get one or many profiles",
        "description": "Send `id` for one profile or `ids` (1 to 100) for several, never both. A batch returns profiles in the order of `ids`. A profile exists only after a Profiles run has written it to the Redis destination",
        "operationId": "getProfiles",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilesRequest"
              },
              "examples": {
                "single": {
                  "value": {
                    "entity": "user",
                    "destinationId": "2aBcDeFgHiJkLmNoPqRsTuVwXyZ",
                    "id": {
                      "type": "user_id",
                      "value": "u123"
                    }
                  }
                },
                "batch": {
                  "value": {
                    "entity": "user",
                    "destinationId": "2aBcDeFgHiJkLmNoPqRsTuVwXyZ",
                    "ids": [
                      {
                        "type": "user_id",
                        "value": "u123"
                      },
                      {
                        "type": "email",
                        "value": "alex@example.com"
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A `Profile` for a single-profile request, `BatchProfilesResponse` for a batch request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                },
                "examples": {
                  "single": {
                    "value": {
                      "entity": "user",
                      "id": {
                        "type": "user_id",
                        "value": "u123"
                      },
                      "data": {
                        "lifetime_value": 420,
                        "is_churn_risk": false
                      }
                    }
                  },
                  "batch": {
                    "value": {
                      "profiles": [
                        {
                          "entity": "user",
                          "id": {
                            "type": "user_id",
                            "value": "u123"
                          },
                          "data": {
                            "lifetime_value": 420
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ActivationBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/ApiUnauthorized"
          },
          "404": {
            "$ref": "#/components/responses/ActivationNotFound"
          }
        },
        "security": [
          {
            "serviceAccessToken": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Activation"
        ],
        "summary": "Delete one or many profiles from the Redis destination",
        "description": "Send `id` for one profile or `ids` (1 to 100) for several. Deletes only the copy in the Redis destination. The next Profiles run recreates it",
        "operationId": "deleteProfiles",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Deletion counts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteProfilesResult"
                },
                "example": {
                  "deletedKeys": 20,
                  "actualKeys": 30
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ActivationBadRequest"
          },
          "404": {
            "description": "None of the provided IDs were found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "None of the provided userIds were found"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ApiServerError"
          }
        },
        "security": [
          {
            "serviceAccessToken": []
          }
        ]
      },
      "servers": [
        {
          "url": "https://profiles.rudderstack.com/v2",
          "description": "Activation API, US"
        },
        {
          "url": "https://profiles-eu.rudderstack.com/v2",
          "description": "Activation API, EU"
        }
      ]
    },
    "/sources/{profilesId}/start": {
      "post": {
        "tags": [
          "Profiles"
        ],
        "summary": "Run a Profiles project",
        "description": "Starts identity resolution and the feature-table build of a Profiles project. Only one run per project can be in progress",
        "operationId": "startProfilesRun",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProfilesId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartProfilesRunRequest"
              },
              "example": {
                "parameters": [
                  "--model_refs models/id_graph_users"
                ]
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "Run started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartProfilesRunResponse"
                },
                "example": {
                  "runId": "2cJmVZmRGZ8xLrKPgTuNqWvBdXh"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ApiUnauthorized"
          },
          "409": {
            "description": "A run is already in flight for this project. The docs define no body for this response.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceAccessToken": []
          }
        ]
      },
      "servers": [
        {
          "url": "https://api.rudderstack.com/v2",
          "description": "Profiles API, US"
        },
        {
          "url": "https://api.eu.rudderstack.com/v2",
          "description": "Profiles API, EU"
        }
      ]
    },
    "/sources/{profilesId}/runs/{runId}/status": {
      "get": {
        "tags": [
          "Profiles"
        ],
        "summary": "Get a run's status",
        "description": "`status` is `running` or `finished`. A failed run also reports `finished` and sets `error`",
        "operationId": "getProfilesRunStatus",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProfilesId"
          },
          {
            "name": "runId",
            "in": "path",
            "description": "Run ID returned by `startProfilesRun`",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The run's status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfilesRunStatus"
                },
                "example": {
                  "jobId": "job-1",
                  "jobRunId": "2cJmVZmRGZ8xLrKPgTuNqWvBdXh",
                  "status": "finished",
                  "startedAt": "2024-05-31T06:48:08.228Z",
                  "finishedAt": "2024-05-31T07:02:11.904Z",
                  "tasks": [
                    {
                      "taskId": "t1",
                      "taskRunId": "tr1",
                      "startedAt": "2024-05-31T06:48:08.228Z",
                      "finishedAt": "2024-05-31T06:52:00.000Z"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ApiUnauthorized"
          },
          "404": {
            "description": "Unknown project or run.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceAccessToken": []
          }
        ]
      },
      "servers": [
        {
          "url": "https://api.rudderstack.com/v2",
          "description": "Profiles API, US"
        },
        {
          "url": "https://api.eu.rudderstack.com/v2",
          "description": "Profiles API, EU"
        }
      ]
    }
  },
  "components": {
    "schemas": {
      "ProfilesRequest": {
        "description": "Request for one profile (`SingleProfileRequest`, with `id`) or several (`BatchProfilesRequest`, with `ids`)",
        "oneOf": [
          {
            "$ref": "#/components/schemas/SingleProfileRequest"
          },
          {
            "$ref": "#/components/schemas/BatchProfilesRequest"
          }
        ]
      },
      "ScreenEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CommonEventFields"
          },
          {
            "$ref": "#/components/schemas/ScreenEventFields"
          }
        ],
        "description": "Records a mobile app screen view"
      },
      "EventType": {
        "type": "string",
        "enum": [
          "identify",
          "track",
          "page",
          "screen",
          "group",
          "alias"
        ],
        "description": "Type of an event in a batch"
      },
      "BatchedEvent": {
        "description": "One event in a batch. Set `type`, plus the field that event type requires: `event` for `track`, `name` for `page` and `screen`, `groupId` for `group`, and `previousId` for `alias`",
        "allOf": [
          {
            "$ref": "#/components/schemas/CommonEventFields"
          },
          {
            "$ref": "#/components/schemas/BatchedEventFields"
          }
        ]
      },
      "Properties": {
        "type": "object",
        "additionalProperties": true,
        "description": "Free-form event or page properties"
      },
      "Traits": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address"
          },
          "name": {
            "type": "string",
            "description": "Full name"
          },
          "firstName": {
            "type": "string",
            "description": "First name"
          },
          "lastName": {
            "type": "string",
            "description": "Last name"
          },
          "phone": {
            "type": "string",
            "description": "Phone number"
          },
          "address": {
            "type": "object",
            "additionalProperties": true,
            "description": "Postal address"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Time the user or group was created"
          }
        },
        "additionalProperties": true,
        "description": "User or group traits. Free-form; common keys are listed"
      },
      "Profile": {
        "required": [
          "data",
          "entity",
          "id"
        ],
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Traits materialised into Redis. Empty when the identity has no profile"
          },
          "id": {
            "$ref": "#/components/schemas/ProfileIdentifier",
            "description": "Identity of the profile"
          },
          "entity": {
            "type": "string",
            "description": "Profiles entity, e.g. `user`"
          }
        },
        "description": "A profile materialised in the Redis destination"
      },
      "Integrations": {
        "type": "object",
        "additionalProperties": true,
        "description": "Turns destinations on or off for this event, e.g. `{\"All\": true, \"Mixpanel\": false}`"
      },
      "AliasEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CommonEventFields"
          },
          {
            "$ref": "#/components/schemas/AliasEventFields"
          }
        ],
        "description": "Merges two identities of a user"
      },
      "CommonEventFields": {
        "type": "object",
        "properties": {
          "anonymousId": {
            "type": "string",
            "description": "Pseudo-ID for a user who isn't known yet"
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "channel": {
            "type": "string",
            "description": "Where the event came from, e.g. `server`, `web`, `mobile`"
          },
          "messageId": {
            "type": "string",
            "description": "Unique message ID, used for deduplication"
          },
          "sentAt": {
            "type": "string",
            "description": "Client time when the event was sent",
            "format": "date-time"
          },
          "userId": {
            "type": "string",
            "description": "The user's ID in your system"
          },
          "integrations": {
            "$ref": "#/components/schemas/Integrations"
          },
          "originalTimestamp": {
            "type": "string",
            "description": "Client time when the event occurred",
            "format": "date-time"
          },
          "timestamp": {
            "type": "string",
            "description": "When the event happened (ISO 8601). Omit for live events; set for historical imports",
            "format": "date-time"
          }
        },
        "description": "Fields shared by every event. Set `userId` or `anonymousId` to identify the user"
      },
      "PageEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CommonEventFields"
          },
          {
            "$ref": "#/components/schemas/PageEventFields"
          }
        ],
        "description": "Records a web page view"
      },
      "Context": {
        "type": "object",
        "properties": {
          "traits": {
            "$ref": "#/components/schemas/Traits"
          },
          "ip": {
            "type": "string",
            "description": "IP address of the user"
          },
          "locale": {
            "type": "string",
            "example": "en-US",
