          {
            "$ref": "#/components/parameters/AnonymousIdHeader"
          },
          {
            "$ref": "#/components/parameters/SentAtHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PageEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Accepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/SourceDisabled"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/screen": {
      "post": {
        "tags": [
          "Event Stream"
        ],
        "summary": "Record a mobile app screen view",
        "operationId": "screen",
        "parameters": [
          {
            "$ref": "#/components/parameters/AnonymousIdHeader"
          },
          {
            "$ref": "#/components/parameters/SentAtHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScreenEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Accepted"
