    "responses": {
      "Accepted": {
        "description": "Event accepted",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            },
            "example": "ok"
          }
        }
      },
      "BadRequest": {
        "description": "Invalid JSON, empty batch, or an event over the size or nesting limit. A missing `userId` and\n`anonymousId` gives `400` only on data planes configured to enforce it (see `CommonEventFields`).\n",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            },
            "examples": {
              "invalidJson": {
                "value": "invalid json"
              },
              "emptyBatch": {
                "value": "empty batch payload"
              },
              "noIdentifier": {
                "value": "request neither has anonymousId nor userId"
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid write key.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            },
            "examples": {
              "missing": {
                "value": "failed to read writekey from header"
              },
              "invalid": {
                "value": "invalid write key"
              }
            }
          }
        }
      },
      "SourceDisabled": {
        "description": "The write key is valid but its source is disabled.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            },
            "example": "source is disabled"
          }
        }
      },
      "PayloadTooLarge": {
        "description": "Request body over the data plane's maximum (4 MB by default).",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            },
            "example": "request size exceeds max limit"
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limited.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            },
            "example": "max requests limit reached"
          }
        }
      },
      "ServerError": {
        "description": "Data plane failure.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "ActivationBadRequest": {
        "description": "Empty `id`/`ids`, or more than 100 IDs.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "emptyId": {
                "value": {
                  "message": "id should have at least one item"
                }
              },
              "empty": {
                "value": {
                  "message": "ids should have at least one item"
                }
              },
              "tooMany": {
                "value": {
                  "message": "ids should have at most 100 items"
                }
              }
            }
          }
        }
      },
      "ActivationNotFound": {
        "description": "The destination isn't a Redis destination, or the ID is blank.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Invalid Destination. Please verify you are passing the right destination ID"
            }
          }
        }
      },
      "ApiUnauthorized": {
        "description": "Missing or invalid access token, or no access to the resource.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Unauthorized request. Please check your access token"
            }
          }
        }
      },
      "ApiServerError": {
        "description": "RudderStack-side failure.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "message": "Internal server error"
            }
          }
        }
      }
    },
    "parameters": {
      "SentAtHeader": {
        "name": "SentAt",
        "in": "header",
        "description": "Time the request was sent (ISO 8601)",
        "required": false,
        "style": "simple",
        "explode": false,
        "schema": {
          "type": "string",
          "format": "date-time"
        },
        "x-ballerina-name": "sentAt"
      },
      "AnonymousIdHeader": {
        "name": "AnonymousId",
        "in": "header",
        "description": "Ordering key. The data plane processes requests that share this value in order. Without it, ordering across requests isn't guaranteed",
        "required": false,
        "style": "simple",
        "explode": false,
        "schema": {
          "type": "string"
        },
        "x-ballerina-name": "anonymousId"
      },
      "ProfilesId": {
        "name": "profilesId",
        "in": "path",
        "description": "ID of the Profiles project",
        "required": true,
        "style": "simple",
        "explode": false,
        "schema": {
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "writeKey": {
        "type": "http",
        "description": "Event Stream. Source write key as the username; the data plane ignores the password.\n",
        "scheme": "basic"
      },
      "serviceAccessToken": {
        "type": "http",
        "description": "Activation and Profiles. Workspace Service Access Token: Destination Data Access on the Redis\ndestination (Activation), or Edit on the Profiles resource (Profiles).\n",
        "scheme": "bearer"
      }
    }
  }
}