{
  "openapi": "3.0.3",
  "info": {
    "title": "RudderStack API",
    "description": "Write customer events to RudderStack through the Event Stream (HTTP) API, read and delete the profiles that RudderStack Profiles builds through the Activation API, and trigger and monitor Profiles runs through the Profiles API.",
    "contact": {
      "name": "RudderStack API documentation",
      "url": "https://www.rudderstack.com/docs/api/"
    },
    "version": "2.0.0",
    "x-ballerina-display": {
      "label": "RudderStack"
    }
  },
  "externalDocs": {
    "url": "https://www.rudderstack.com/docs/api/"
  },
  "servers": [
    {
      "url": "{dataPlaneUrl}",
      "description": "Event Stream. Your RudderStack data plane, or a self-hosted rudder-server.",
      "variables": {
        "dataPlaneUrl": {
          "description": "Data plane URL from the RudderStack dashboard, e.g. https://example.dataplane.rudderstack.com",
          "default": "https://hosted.rudderlabs.com"
        }
      }
    }
  ],
  "security": [
    {
      "writeKey": []
    }
  ],
  "tags": [
    {
      "name": "Event Stream",
      "description": "Write traits and events to the data plane. https://www.rudderstack.com/docs/api/http-api/"
    },
    {
      "name": "Activation",
      "description": "Read and delete profiles materialised into Redis. https://www.rudderstack.com/docs/profiles/dev-docs/activation-api/"
    },
    {
      "name": "Profiles",
      "description": "Trigger and monitor Profiles project runs. https://www.rudderstack.com/docs/api/profiles-api/"
    }
  ],
  "paths": {
    "/v1/identify": {
      "post": {
        "tags": [
          "Event Stream"
        ],
        "summary": "Identify a user and record their traits",
        "operationId": "identify",
        "parameters": [
          {
            "$ref": "#/components/parameters/AnonymousIdHeader"
          },
          {
            "$ref": "#/components/parameters/SentAtHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentifyEvent"
              },
              "example": {
                "userId": "u123",
                "traits": {
                  "email": "alex@example.com",
                  "firstName": "Alex",
                  "plan": "enterprise"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Accepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/SourceDisabled"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/track": {
      "post": {
        "tags": [
          "Event Stream"
        ],
        "summary": "Record an action a user performed",
        "operationId": "track",
        "parameters": [
          {
            "$ref": "#/components/parameters/AnonymousIdHeader"
          },
          {
            "$ref": "#/components/parameters/SentAtHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrackEvent"
              },
              "example": {
                "userId": "u123",
                "event": "Signed Up",
                "properties": {
                  "application": "My App"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Accepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/SourceDisabled"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/page": {
      "post": {
        "tags": [
          "Event Stream"
        ],
        "summary": "Record a web page view",
