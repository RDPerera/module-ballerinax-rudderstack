        "tags": [
          "Event Stream"
        ],
        "summary": "Merge two user identities",
        "operationId": "alias",
        "parameters": [
          {
            "$ref": "#/components/parameters/AnonymousIdHeader"
          },
          {
            "$ref": "#/components/parameters/SentAtHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AliasEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Accepted"
          },
